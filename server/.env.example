# ─── Quiz Arena — server/.env Example ────────────────────────────────────────
# Copy this file to server/.env and fill in your values.
# NEVER commit server/.env to git.

# Gemini API key for the Strands agents (AI commentator, tutor, hint, syllabus)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Security ────────────────────────────────────────────────────────────────
# Must match INTERNAL_SECRET in the root .env
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=change_me_to_a_long_random_secret

# Optional: AWS S3 bucket for syllabi/quizzes storage (leave empty for local files)
# AWS_S3_BUCKET_NAME=your-bucket-name
