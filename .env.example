# ─── Quiz Arena — Root .env Example ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Firebase (Frontend — VITE_ prefix exposes these to the browser build)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# API Gateway URL (used by the Vite build)
VITE_API_URL=http://localhost:3001

# Gateway settings (consumed by server/index.js)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Security ────────────────────────────────────────────────────────────────
# Shared secret between gateway and strands-service.
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=change_me_to_a_long_random_secret

# Comma-separated list of Google account emails allowed to call /api/agent/* routes.
# Leave empty to allow ANY authenticated Firebase user (NOT recommended for production).
ADMIN_EMAILS=your_admin@example.com
